# ==========================================
# GRAINS OF TIME - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ------------------------------------------
# Public Site URL
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# Sanity CMS Configuration
# ------------------------------------------
# Obtain these from your Sanity project dashboard: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=6g0hypo7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Secret token with viewer/read access for draft-mode previews (Never expose with NEXT_PUBLIC_)
SANITY_API_READ_TOKEN=

# Secret token configured in Sanity webhook for on-demand ISR revalidation (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# ------------------------------------------
# Booking Inquiries & Notifications
# ------------------------------------------
# Primary recipient for performance and booking requests (e.g., booking@grainsoftime.com)
BOOKING_RECIPIENT_EMAIL=booking@grainsoftime.com

# Optional Resend API key for sending inquiry notification emails (https://resend.com)
# If left empty, submissions are safely logged to console and stored in CMS.
RESEND_API_KEY=

# ------------------------------------------
# Official Instagram Integration (Meta Graph API)
# ------------------------------------------
# Optional official Meta Graph API access token for @grainsoftime.
# If omitted or expired, site gracefully falls back to curated CMS social showcase.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
